# Copy to .env.local. Never commit real credentials.
# Set up your own development deployment with npx convex dev.
NEXT_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-development-deployment.convex.site

# Optional Next.js error monitoring.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Offline seed scripts only. Generate with: openssl rand -hex 32
# Configure the SAME SEED_ADMIN_KEY privately in your Convex deployment.
# Maintenance endpoints reject requests when this is unset or too short.
SEED_ADMIN_KEY=

# Offline content generation only; do not prefix these with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Runtime providers are configured privately in Convex, not in the browser:
# GEMINI_API_KEY, GROQ_API_KEY, DEEPSEEK_API_KEY, LANGBLY_API_KEY (optional),
# SENTRY_DSN (optional), plus GitHub OAuth / Convex Auth configuration.
